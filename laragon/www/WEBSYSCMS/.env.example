APP_NAME="FixitNow: Appliance Maintenance and Service Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://WEBSYSCMS.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fixflow_cms
DB_USERNAME=root
DB_PASSWORD=
# Optional Aiven CA certificate (base64) for the Vercel container.
MYSQL_ATTR_SSL_CA_BASE64=
LOCATION_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
LOCATION_REVERSE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production password recovery requires a real mail provider; never use the log mailer in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google AdSense (enable only after setting up your publisher and ad unit IDs).
ADSENSE_ENABLED=true
ADSENSE_PUBLISHER_ID=ca-pub-6822467849493755
ADSENSE_PUBLIC_SLOT_ID=4652086988

# Technician subscription plans (PHP).
TECHNICIAN_SUBSCRIPTION_MONTHLY_PRICE=500
TECHNICIAN_SUBSCRIPTION_YEARLY_PRICE=5000
# Optional manual GCash fallback. Keep real account details in .env only.
GCASH_ACCOUNT_NAME=
GCASH_ACCOUNT_NUMBER=
SUBSCRIPTION_PROOF_DISK=local

# Optional: enable simulated checkout locally or in a Vercel Preview deployment.
# SUBSCRIPTION_DEMO_MODE=true
# For a presentation-only production deployment, explicitly enable both flags.
# Never use these settings on a site accepting real payments.
# SUBSCRIPTION_DEMO_MODE=true
# SUBSCRIPTION_DEMO_ALLOW_PRODUCTION=true

# PayMongo Hosted Checkout. Use test keys during development.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# One-time production admin bootstrap. Set in Render only, then remove after success.
# ADMIN_BOOTSTRAP_ONCE=true
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
